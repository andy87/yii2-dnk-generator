{
  "name": "andy87/yii2-dnk-generator",
  "description": "My workflow for `template path` pattern",
  "type": "library",
  "keywords": [
    "yii2",
    "generator"
  ],
  "license": "MIT",
  "homepage": "https://github.com/andy87/yii2-dnk-generator",
  "authors": [
    {
      "name": "Kidin and_y87 Andrey",
      "email": "kidin_a@list.ru",
      "homepage": "https://andy87.ru",
      "role": "Author"
    }
  ],
  "version"     : "1.0.0",
  "minimum-stability": "stable",
  "require": {
    "yiisoft/yii2": "*"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    },
    {
      "type": "vcs",
      "url": "https://github.com/andy87/yii2-dnk-generator"
    }
  ],
  "autoload": {
    "psr-4": {
      "andy87\\dnk\\": "src"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}
